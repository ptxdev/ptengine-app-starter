{
    "contractVersion": "0.1.0",
    "appId": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,49}$",
        "parsePattern": "^[a-z0-9][a-z0-9-]{0,62}$",
        "maxLen": 50,
        "reserved": [
            "www",
            "api",
            "admin",
            "auth",
            "app",
            "apps",
            "console",
            "jwks",
            "static",
            "cdn",
            "mail",
            "ptengine",
            "media"
        ],
        "reservedPrefix": "pt-"
    },
    "name": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "reservedPrefix": "PT_",
        "reservedBindingNames": [
            "DB",
            "KV",
            "FILES",
            "PT_APP",
            "PT_JWKS_URL",
            "PT_TOKEN_ISS",
            "PT_TOKEN_AUD",
            "PT_GATEWAY",
            "PT_OPENAPI_URL"
        ]
    },
    "limits": {
        "vars": 64,
        "secrets": 64,
        "egress": 32,
        "configValueBytes": 4096
    },
    "forbiddenEgress": [
        "ptengine.com",
        "ptengine.io",
        "ptengine.ai",
        "ptmind.com",
        "ptmind.net",
        "localhost",
        "127.0.0.1",
        "0.0.0.0"
    ],
    "minCompatibilityDate": "2026-09-01",
    "validScopes": [
        "analytics:read",
        "profile:read",
        "user:read",
        "ui:notify",
        "openapi:read",
        "asset:write",
        "ai:invoke",
        "asset:read",
        "jobs:run",
        "notify:send"
    ],
    "aiModels": [
        "anthropic/claude-opus-5-5",
        "anthropic/claude-opus-5",
        "anthropic/claude-opus-4-8",
        "anthropic/claude-opus-4-5",
        "anthropic/claude-sonnet-5-5",
        "anthropic/claude-sonnet-5",
        "anthropic/claude-sonnet-4-6",
        "anthropic/claude-sonnet-4-5",
        "anthropic/claude-haiku-4-5",
        "anthropic/claude-haiku-4-5-20251001",
        "custom-tokenops/claude-opus-5-5",
        "custom-tokenops/claude-opus-5",
        "custom-tokenops/claude-opus-4-8",
        "custom-tokenops/claude-sonnet-5",
        "custom-tokenops/claude-sonnet-4-6",
        "custom-tokenops/claude-haiku-5-5",
        "custom-tokenops/claude-haiku-4-5-20251001",
        "google-ai-studio/gemini-2.5-pro",
        "google-ai-studio/gemini-3.8-flash",
        "google-ai-studio/gemini-3.6-flash",
        "google-ai-studio/gemini-2.5-flash",
        "google-ai-studio/gemini-3.1-flash-lite",
        "google-ai-studio/gemini-2.5-flash-lite",
        "custom-tokenops/gpt-5.6-luna",
        "custom-tokenops/gpt-5.6-sol",
        "custom-tokenops/gpt-5.6-terra",
        "custom-tokenops/gpt-6.1-sol",
        "custom-tokenops/gpt-6-astra",
        "custom-tokenops/gpt-6-luna",
        "custom-tokenops/gpt-6-sol"
    ],
    "jobResult": {
        "maxBytes": 262144,
        "markdownMaxBytes": 204800,
        "maxFiles": 5,
        "fileTypes": [
            "text/csv"
        ],
        "titleMax": 200,
        "fileNameMax": 120
    },
    "notify": {
        "maxRefsPerCall": 50,
        "maxRecipientsPerRun": 50,
        "maxCallsPerRun": 20,
        "subjectMax": 200,
        "htmlMaxBytes": 262144,
        "textMaxBytes": 65536,
        "locales": [
            "zh-CN",
            "en-US",
            "ja-JP"
        ],
        "defaultLocale": "ja-JP",
        "refPattern": "^(user:[A-Za-z0-9_-]{1,64}|role:(owner|admin|member))$",
        "replyToPattern": "^user:[A-Za-z0-9_-]{1,64}$",
        "roles": [
            "owner",
            "admin",
            "member"
        ],
        "maxConcurrentPerApp": 2
    },
    "render": {
        "optionMaxBytes": 524288,
        "minDimension": 100,
        "maxDimension": 2000,
        "defaultWidth": 800,
        "defaultHeight": 400,
        "themes": [
            "light",
            "dark"
        ],
        "maxPerRun": 20,
        "maxDepth": 32,
        "forbiddenKeys": [
            "image"
        ],
        "forbiddenStringPrefixes": [
            "image://"
        ],
        "droppedTopLevelKeys": [
            "toolbox",
            "brush",
            "timeline"
        ],
        "jsonOnly": true,
        "maxNodes": 100000,
        "maxArrayLength": 50000,
        "maxStringLength": 16384,
        "forbiddenCharsPattern": "[\"<>\\u0000-\\u0008\\u000b-\\u001f]",
        "forbiddenSubstrings": [
            "&#"
        ],
        "cssFieldKeyPattern": "^(?:color|fill|stroke|font|fontFamily|fontWeight|fontStyle|fontSize)$|Color$",
        "cssFieldForbiddenChars": [
            ";"
        ],
        "protoKeys": [
            "__proto__",
            "constructor",
            "prototype"
        ],
        "svgAllowedElements": [
            "svg",
            "g",
            "path",
            "rect",
            "circle",
            "ellipse",
            "line",
            "polyline",
            "polygon",
            "text",
            "tspan",
            "defs",
            "linearGradient",
            "radialGradient",
            "stop",
            "clipPath",
            "pattern",
            "filter",
            "feDropShadow",
            "title",
            "desc"
        ],
        "maxConcurrentPerApp": 2,
        "timeoutMs": 5000
    },
    "jobLog": {
        "headerName": "x-pt-job-log",
        "headerMaxBytes": 12288,
        "maxEntries": 200,
        "entryMessageMax": 2000,
        "entryFieldsMaxBytes": 4096
    },
    "gateway": {
        "gateHeader": {
            "name": "x-pt-gate",
            "concurrencyValue": "concurrency"
        }
    },
    "notifyChannel": {
        "types": [
            "slack",
            "teams",
            "chatwork",
            "webhook"
        ],
        "namePattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "titleMax": 150,
        "textMax": 3000,
        "linkLabelMax": 50,
        "linkPathMax": 512,
        "linkPathPattern": "^[A-Za-z0-9\\-._~!$&'()*+,;=:@\\/?%]*$",
        "maxPerRun": 10,
        "maxPerWorkspacePerMinute": 30,
        "mediaPathPattern": "^\\/media\\/[A-Za-z0-9_-]{1,64}\\/[a-z0-9-]{1,63}\\/[0-9a-f]{32}\\.png$",
        "testTitlePrefix": "[TEST] ",
        "webhookHeaders": {
            "id": "x-pt-webhook-id",
            "timestamp": "x-pt-webhook-timestamp",
            "signature": "x-pt-webhook-signature"
        },
        "signatureVersion": "v1",
        "maxConcurrentPerApp": 2,
        "maxBodyBytes": 16384
    }
}
