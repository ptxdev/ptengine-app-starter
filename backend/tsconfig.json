{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "composite": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
